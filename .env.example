# Copy with: npm run setup (recommended). Do not use these placeholders as real secrets.
AI_AGENT_VAULT_KEY=replace-with-at-least-32-random-characters
AI_AGENT_ACCESS_TOKEN=replace-with-at-least-32-random-characters
AI_AGENT_HOST=127.0.0.1
# Set false on a self-hosted VM even when bound to loopback behind a reverse proxy.
AI_AGENT_ALLOW_OAUTH=true
PORT=8787
